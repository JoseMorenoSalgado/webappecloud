# Crear usuario/base en cPanel → MySQL/MariaDB
DATABASE_URL="mysql://usuario:contraseña@127.0.0.1:3306/cpanel_basedatos"
# Requeridos ÚNICAMENTE para crear el primer administrador con el seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Opcional: dominio de la app al arrancar, sin protocolo
SEED_DOMAIN="localhost"

# Preview STAGING sin DB; permitir SOLO en el dominio indicado
SITE_PREVIEW_MODE="false"
SITE_PREVIEW_HOST="inmo.elearningcloud.org"
